{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Navi",
  "mainBinaryName": "Navi",
  "version": "0.3.6",
  "identifier": "dev.navi.win",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Navi",
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "customLanguageFiles": { "SimpChinese": "../installer/SimpChinese.nsh" },
        "installerHooks": "../installer/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    },
    "deep-link": {
      "desktop": { "schemes": ["navi"] }
    }
  }
}
